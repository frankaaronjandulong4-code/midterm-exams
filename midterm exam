<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Frank Aaron S. Jandulong - Portfolio</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }
    body { background: #0b0c10; color: #c5c6c7; line-height: 1.6; }
    
    /* Navigation Bar */
    nav { display: flex; justify-content: space-between; align-items: center; padding: 1.2rem 8%; background: rgba(11,12,16,0.9); position: fixed; width: 100%; top: 0; z-index: 100; border-bottom: 1px solid #1f2833; }
    .logo { font-size: 1.4rem; font-weight: 700; color: #66fcf1; text-transform: uppercase; letter-spacing: 1px; }
    .nav-links { display: flex; gap: 2rem; list-style: none; }
    .nav-links a { color: #c5c6c7; text-decoration: none; font-weight: 500; transition: color 0.3s; }
    .nav-links a:hover { color: #66fcf1; }

    /* Hero Section */
    .hero { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 6rem 8% 2rem; background: radial-gradient(circle at center, #1f2833 0%, #0b0c10 70%); text-align: center; }
    .hero-content { max-width: 700px; }
    .hero h1 { font-size: 2.8rem; color: #fff; margin-bottom: 1rem; }
    .hero h1 span { color: #66fcf1; }
    .hero p { font-size: 1.1rem; color: #45a29e; margin-bottom: 2rem; }
    .btn { display: inline-block; padding: 0.8rem 2rem; background: #66fcf1; color: #0b0c10; font-weight: 700; border-radius: 5px; text-decoration: none; transition: 0.3s; }
    .btn:hover { background: #45a29e; color: #fff; }

    /* Services Section */
    .services { padding: 5rem 8%; text-align: center; }
    .services h2 { font-size: 2rem; color: #fff; margin-bottom: 2.5rem; position: relative; }
    .services h2::after { content: ''; display: block; width: 50px; height: 3px; background: #66fcf1; margin: 0.5rem auto 0; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; }
    .card { background: #1f2833; padding: 2rem; border-radius: 8px; border: 1px solid #2c3a47; transition: transform 0.3s, border-color 0.3s; }
    .card:hover { transform: translateY(-5px); border-color: #66fcf1; }
    .card h3 { color: #fff; margin-bottom: 0.8rem; }
    .card p { font-size: 0.95rem; }

    /* Footer */
    footer { padding: 2rem 8%; background: #070709; border-top: 1px solid #1f2833; text-align: center; font-size: 0.9rem; }
    footer span { color: #66fcf1; }

    /* Responsive Design */
    @media (max-width: 768px) {
      nav { flex-direction: column; gap: 1rem; padding: 1rem; }
      .nav-links { gap: 1rem; }
      .hero h1 { font-size: 2rem; }
      .services { padding: 4rem 5%; }
    }
  </style>
</head>
<body>

  <!-- Navigation Bar -->
  <nav>
    <div class="logo">Frank Aaron</div>
    <ul class="nav-links">
      <li><a href="#home">Home</a></li>
      <li><a href="#services">Services</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </nav>

  <!-- Hero Section -->
  <section id="home" class="hero">
    <div class="hero-content">
      <h1>Hi, I'm <span>Frank Aaron S. Jandulong</span></h1>
      <p>Web Systems & Technologies 1 — Hands-On Examination</p>
      <a href="#services" class="btn">Explore Work</a>
    </div>
  </section>

  <!-- Services Section -->
  <section id="services" class="services">
    <h2>Core Expertise</h2>
    <div class="grid">
      <div class="card">
        <h3>Web Development</h3>
        <p>Building clean, structured single-file layouts using modern HTML5 and semantic components.</p>
      </div>
      <div class="card">
        <h3>CSS Architecture</h3>
        <p>Crafting dark-mode interfaces utilizing Flexbox, CSS Grid, and fluid media queries.</p>
      </div>
      <div class="card">
        <h3>Database & BI</h3>
        <p>Designing efficient relational schemas, normalization pipelines, and analytical visual dashboards.</p>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer id="contact">
    <p>&copy; 2026 <span>Frank Aaron S. Jandulong</span>. All Rights Reserved. | Marinduque State University</p>
  </footer>

</body>
</html>